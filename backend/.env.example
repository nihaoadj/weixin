APP_ENV=development
DATABASE_URL=sqlite:///./data/dev.db
JWT_SECRET=change-me-in-local-env
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ENABLE_DEMO_AUTH=true
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=12

# PBL: production must use Coze. OpenAI-compatible is development/test only.
PBL_AI_ENABLED=false
PBL_AI_PROVIDER=coze
PBL_AI_TIMEOUT_SECONDS=12
PBL_AI_PROMPT_VERSION=pathology-pbl-v1
COZE_API_BASE=
COZE_API_TOKEN=
COZE_INVOCATION_MODE=bot
COZE_BOT_ID=
COZE_WORKFLOW_ID=
COZE_APP_ID=
PBL_OPENAI_BASE_URL=
PBL_OPENAI_API_KEY=
PBL_OPENAI_MODEL=
AI_PROMPT_VERSION=case-v2
PRACTICE_PROMPT_VERSION=practice-v1
SEED_SHOWCASE_CASE=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
# 逗号分隔的微信 openid；只有白名单账号可首次以教师身份登录。
WECHAT_TEACHER_OPENIDS=
