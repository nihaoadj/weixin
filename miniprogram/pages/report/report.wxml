<view class="container">
  <!-- 报告内容 -->
  <scroll-view class="report-container" scroll-y="true">
    <!-- 报告头部 -->
    <view class="report-header">
      <text class="report-title">医学知识问答报告</text>
      <text class="report-time">{{report.createdAt}}</text>
    </view>
    
    <!-- 分析结果 -->
    <view class="section">
      <text class="section-title">AI分析结果</text>
      <view class="analysis-content">
        <view class="analysis-item">
          <text class="analysis-label">总分：</text>
          <text class="analysis-value">{{report.analysis.score}} 分</text>
        </view>
        <view class="analysis-item">
          <text class="analysis-label">总结：</text>
          <text class="analysis-value">{{report.analysis.summary}}</text>
        </view>
      </view>
    </view>
    
    <!-- 错误点分析 -->
    <view class="section">
      <text class="section-title">错误点分析</text>
      <view class="error-list">
        <view wx:for="{{report.analysis.errors}}" wx:key="{{index}}" class="error-item">
          <text class="error-label">错误 {{index + 1}}：</text>
          <text class="error-content">{{item.content}}</text>
          <text class="suggestion-label">改进建议：</text>
          <text class="suggestion-content">{{item.suggestion}}</text>
        </view>
      </view>
    </view>
    
    <!-- 对话内容预览 -->
    <view class="section">
      <text class="section-title">对话内容预览</text>
      <view class="conversation-preview">
        <view wx:for="{{previewMessages}}" wx:key="{{index}}" class="message-item">
          <view class="message-avatar">{{item.role === "user" ? "我" : "AI"}}</view>
          <view class="message-content">
            <text class="message-text">{{item.content}}</text>
          </view>
        </view>
        <view wx:if="{{report.messages.length > 5}}" class="more-message">
          <text>... 还有 {{report.messages.length - 5}} 条消息</text>
        </view>
      </view>
    </view>
  </scroll-view>
  
  <!-- 操作按钮 -->
  <view class="action-container">
    <button class="submit-btn" bindtap="submitToTeacher">
      提交给教师批阅
    </button>
    <button class="back-btn" bindtap="backToChat">
      返回聊天
    </button>
  </view>
</view>