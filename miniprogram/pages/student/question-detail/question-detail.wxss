page {
  background: #ffffff;
  min-height: 100vh;
  margin: 0;
  padding: 0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
  margin: 0;
  padding: 0;
}

.question-info-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-type,
.info-time {
  font-size: 24rpx;
  color: #1a1a1a;
}

.info-divider {
  font-size: 24rpx;
  color: #e8eaed;
}

.chat-container {
  flex: 1;
  padding: 24rpx 24rpx 0;
  overflow-y: auto;
  margin: 0;
}

.message-wrapper {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-wrapper {
  display: flex;
  justify-content: flex-end;
  padding-right: 16rpx;
}

.ai-wrapper {
  display: flex;
  justify-content: flex-start;
  padding-left: 16rpx;
}

.message-bubble {
  padding: 24rpx;
  border-radius: 24rpx;
  position: relative;
  max-width: 85%;
}

.user-bubble {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.35);
}

.ai-bubble {
  background: #fafafa;
  color: #0a0a0a;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #cbd5e1;
}

.message-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-word;
}

.user-bubble .message-text {
  color: #ffffff;
}

.ai-bubble .message-text {
  color: #333333;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: #29b6f6;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

.input-section {
  padding: 8rpx 24rpx 32rpx;
  background: #ffffff;
  margin: 0;
}

.input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0;
}

.input-wrapper {
  flex: 5;
  background: #f5f6f7;
  border-radius: 24rpx;
  border: 2rpx solid #e8eaed;
  transition: all 0.3s ease;
  overflow: hidden;
}

.input-wrapper:focus-within {
  border-color: #00c853;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(0, 200, 83, 0.1);
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333333;
}

.input-placeholder {
  color: #999999;
}

.send-btn {
  flex: 1;
  height: 88rpx;
  background: #f5f6f7;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  border: 1rpx solid #e8eaed;
  padding: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
  border-color: transparent;
}

.send-btn[disabled] {
  background: #f5f6f7;
  border-color: #e8eaed;
}

.send-icon {
  font-size: 36rpx;
  font-weight: 600;
  color: #999999;
}

.send-btn.active .send-icon {
  color: #ffffff;
}