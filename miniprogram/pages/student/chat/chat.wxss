page {
  background: #ffffff;
  min-height: 100vh;
  margin: 0;
  padding: 0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
  margin: 0;
  padding: 0;
}

.header {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  padding-top: calc(48rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #e8eaed;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.header-title {
  display: flex;
  flex-direction: column;
}

.title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.title-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 4rpx;
}

.history-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #f5f6f7;
  border-radius: 40rpx;
  border: 1rpx solid #e8eaed;
  transition: all 0.3s ease;
}

.history-btn:active {
  background: #e8eaed;
}

.history-icon {
  font-size: 28rpx;
}

.history-text {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.chat-container {
  flex: 1;
  padding: 24rpx 24rpx 0;
  overflow-y: auto;
  margin: 0;
}

.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  margin-top: 0;
}

.welcome-icon {
  width: 160rpx;
  height: 160rpx;
  background: transparent;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 32rpx;
}

.icon-text {
  font-size: 64rpx;
  font-weight: bold;
  color: #ff0000;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.icon-image {
  width: 120rpx;
  height: 120rpx;
  object-fit: contain;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  text-align: center;
}

.welcome-desc {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 48rpx;
}

.quick-questions {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.16);
  border: 1rpx solid #ffffff;
}

.quick-title {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 32rpx;
  margin-top: -16rpx;
}

.quick-item {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  border: 1rpx solid #999999;
  transition: all 0.3s ease;
}

.quick-item:last-child {
  margin-bottom: 0;
}

.quick-item:active {
  background: #f5f5f5;
  border-color: #999999;
  transform: scale(0.98);
}

.message-wrapper {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-wrapper {
  display: flex;
  justify-content: flex-end;
  padding-right: 16rpx;
}

.ai-wrapper {
  display: flex;
  justify-content: flex-start;
  padding-left: 16rpx;
}

.message-bubble {
  padding: 24rpx;
  border-radius: 24rpx;
  position: relative;
  max-width: 85%;
}

.user-bubble {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.35);
}

.ai-bubble {
  background: #fafafa;
  color: #0a0a0a;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #e8eaed;
}

.message-role {
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  opacity: 0.9;
}

.user-bubble .message-role {
  color: rgba(255, 255, 255, 0.95);
}

.ai-bubble .message-role {
  color: #666666;
}

.message-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-word;
}

.message-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.ai-bubble .message-footer {
  border-top-color: #e8eaed;
}

.message-time {
  font-size: 22rpx;
  opacity: 0.6;
}

.message-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 22rpx;
  color: #2dd4bf;
  padding: 4rpx 12rpx;
  background: rgba(45, 212, 191, 0.1);
  border-radius: 8rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: #29b6f6;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

.bottom-action-area {
  background: #ffffff;
  border-top: none;
  box-shadow: none;
}

.input-section {
  padding: 8rpx 24rpx 32rpx;
  background: #ffffff;
  margin: 0;
}

.input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0;
}

.input-wrapper {
  flex: 5;
  background: #f5f6f7;
  border-radius: 24rpx;
  border: 2rpx solid #e8eaed;
  transition: all 0.3s ease;
  overflow: hidden;
}

.input-wrapper:focus-within {
  border-color: #00c853;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(0, 200, 83, 0.1);
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333333;
}

.input-placeholder {
  color: #999999;
}

.send-btn {
  flex: 1;
  height: 88rpx;
  background: #f5f6f7;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  border: 1rpx solid #e8eaed;
  padding: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
  border-color: transparent;
}

.send-btn[disabled] {
  background: #f5f6f7;
  border-color: #e8eaed;
}

.send-icon {
  font-size: 36rpx;
  font-weight: 600;
  color: #999999;
}

.send-btn.active .send-icon {
  color: #ffffff;
}

.input-hint {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #999999;
}

.action-buttons-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 24rpx;
  background: #ffffff;
  border-top: none;
  margin: 0;
}

.end-btn {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.3s ease;
  border: 1rpx solid #000000;
  padding: 0 12rpx;
  box-shadow: none;
  color: #000000;
}

.end-btn.active {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.35);
  color: #ffffff;
  border-color: transparent;
}

.end-btn:active {
  background: #f5f5f5;
}

.end-btn[disabled] {
  background: #f5f6f7;
  box-shadow: none;
  opacity: 0.6;
  color: #999999;
}

.end-icon {
  font-size: 28rpx;
  color: #000000;
  margin-right: 8rpx;
}

.end-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
  letter-spacing: 0.5rpx;
}

.end-btn.active .end-text {
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.end-btn.active .end-icon {
  color: #ffffff;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  margin-right: 8rpx;
}

.history-btn-small {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.3s ease;
  border: 1rpx solid #000000;
  padding: 0 12rpx;
  box-shadow: none;
  color: #000000;
}

.history-btn-small:active {
  background: #f5f5f5;
}

.history-icon-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.history-text-small {
  font-size: 24rpx;
  color: #000000;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.question-btn-small {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.3s ease;
  border: 1rpx solid #000000;
  padding: 0 12rpx;
  box-shadow: none;
  color: #000000;
}

.question-btn-small:active {
  background: #f5f5f5;
}

.question-icon-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.question-text-small {
  font-size: 24rpx;
  color: #000000;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
