.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.chat-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.system-message {
  text-align: center;
  margin: 40rpx 0;
  padding: 20rpx;
  background-color: #e6f7ff;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #1890ff;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  max-width: 80%;
}

.user-message {
  flex-direction: row-reverse;
  align-self: flex-end;
}

.ai-message {
  align-self: flex-start;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin: 0 15rpx;
}

.user-message .message-avatar {
  background-color: #4a90e2;
  color: white;
}

.ai-message .message-avatar {
  background-color: #50e3c2;
  color: white;
}

.message-content {
  flex: 1;
  padding: 20rpx;
  border-radius: 20rpx;
  position: relative;
}

.user-message .message-content {
  background-color: #4a90e2;
  color: white;
  border-bottom-right-radius: 5rpx;
}

.ai-message .message-content {
  background-color: white;
  color: #333;
  border-bottom-left-radius: 5rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.message-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 10rpx;
  word-break: break-word;
}

.message-time {
  display: block;
  font-size: 20rpx;
  opacity: 0.7;
  text-align: right;
}

.input-container {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #e8e8e8;
}

.input-field {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-right: 15rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background-color: #4a90e2;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn[disabled] {
  background-color: #ccc;
}

.action-container {
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #e8e8e8;
}

.end-btn {
  width: 100%;
  height: 80rpx;
  background-color: #f5222d;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.end-btn[disabled] {
  background-color: #ccc;
}