<view class="container">
  <view class="logo">
    <text class="logo-text">医学知识问答</text>
  </view>
  
  <view class="role-select">
    <text class="role-title">请选择您的身份</text>
    
    <view class="role-btn student-btn" bindtap="loginAsStudent">
      <text class="role-btn-text">学生</text>
      <text class="role-desc">进行医学知识问答</text>
    </view>
    
    <view class="role-btn teacher-btn" bindtap="loginAsTeacher">
      <text class="role-btn-text">教师</text>
      <text class="role-desc">批阅学生问答报告</text>
    </view>
  </view>
</view>