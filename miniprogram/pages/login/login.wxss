.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f5f5f5;
  padding: 0 20rpx;
}

.logo {
  margin-bottom: 80rpx;
  text-align: center;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.role-select {
  width: 100%;
  max-width: 500rpx;
}

.role-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.role-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 200rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.role-btn:active {
  transform: scale(0.98);
}

.student-btn {
  background-color: #4a90e2;
}

.teacher-btn {
  background-color: #50e3c2;
}

.role-btn-text {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.role-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}