<view class="problem-container">
  <!-- 顶部操作栏 -->
  <view class="action-bar">
    <view class="status-tabs">
      <view class="tab {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="switchStatus" data-status="pending">
        待审核
        <text class="count" wx:if="{{pendingCount > 0}}">{{pendingCount}}</text>
      </view>
      <view class="tab {{currentStatus === 'published' ? 'active' : ''}}" bindtap="switchStatus" data-status="published">
        已发布
      </view>
    </view>
    
    <view class="button-row">
      <button class="add-btn" bindtap="addProblem">
        <image src="/resource/添加.png" class="add-icon"></image>
        <text>新建问题</text>
      </button>
      <button class="add-btn" bindtap="resetData">
        <image src="/resource/刷新.png" class="add-icon"></image>
        <text>刷新数据</text>
      </button>
    </view>
  </view>

  <!-- 问题列表 -->
  <scroll-view class="problem-list" scroll-y="true" bindscrolltolower="loadMoreProblems" enhanced show-scrollbar="{{false}}">
    <block wx:for="{{problemList}}" wx:key="{{item.id}}">
      <view class="problem-item">
        <!-- 问题头部 -->
        <view class="problem-header">
          <view class="header-left">
            <view class="problem-type">{{item.type}}</view>
            <view class="problem-target-tag">
              <text wx:if="{{item.target === 'all'}}">全体学生</text>
              <text wx:if="{{item.target === 'class'}}">{{item.className || '指定班级'}}</text>
              <text wx:if="{{item.target === 'individual'}}">已选择 {{item.studentCount || 0}} 名学生</text>
            </view>
          </view>
          <text class="problem-time">{{item.time}}</text>
        </view>

        <!-- 问题标题 -->
        <view class="problem-title" bindtap="viewProblemDetail" data-id="{{item.id}}">
          {{item.title}}
        </view>

        <!-- 问题描述预览 -->
        <view class="problem-desc" wx:if="{{item.description}}">
          {{item.description}}
        </view>

        <!-- 操作按钮 -->
        <view class="problem-actions">
          <view wx:if="{{currentStatus === 'pending'}}" class="action-buttons">
            <button class="action-btn reject" bindtap="rejectProblem" data-id="{{item.id}}">拒绝</button>
            <button class="action-btn edit" bindtap="editProblem" data-id="{{item.id}}">编辑</button>
            <button class="action-btn publish" bindtap="publishProblem" data-id="{{item.id}}">发布</button>
          </view>

          <view wx:elif="{{currentStatus === 'published'}}" class="action-buttons">
            <text class="publish-time">{{item.publishTime || '已发布'}}</text>
            <button class="action-btn view" bindtap="viewStats" data-id="{{item.id}}">统计</button>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <text>加载中...</text>
    </view>
  </scroll-view>
</view>