page {
  background: #f5f7fa;
  min-height: 100vh;
  margin: 0;
  padding: 0;
}

.problem-container {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部操作栏 */
.action-bar {
  flex-shrink: 0;
  background: #ffffff;
  padding: 20rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #e8eaed;
  width: 100%;
  box-sizing: border-box;
}

/* 状态标签 */
.status-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  background: #f5f7fa;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666666;
  border: 1rpx solid #e8eaed;
  position: relative;
  transition: all 0.3s ease;
}

.tab.active {
  background: #4a90e2;
  color: white;
  border-color: #4a90e2;
}

.tab .count {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.add-icon {
  width: 32rpx;
  height: 32rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.add-btn {
  flex: 1;
  height: 76rpx;
  background: #f5f7fa;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #666666;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.add-btn::after {
  border: none;
}

.add-btn text {
  text-align: center;
  width: 100%;
}

/* 问题列表 */
.problem-list {
  flex: 1;
  width: 100%;
  overflow-y: auto;
  padding: 16rpx 16rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 问题卡片 */
.problem-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  box-sizing: border-box;
  width: 100%;
}

.problem-item:active {
  transform: scale(0.98);
}

.problem-item:last-child {
  margin-bottom: 0;
}

.problem-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-left {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.problem-type {
  padding: 6rpx 14rpx;
  background: #e6f7ff;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 500;
}

.problem-target-tag {
  padding: 6rpx 14rpx;
  background: #f0fdf4;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #22c55e;
  font-weight: 500;
}

.problem-time {
  font-size: 24rpx;
  color: #999999;
}

.problem-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.problem-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  word-break: break-all;
}

.problem-actions {
  display: flex;
  justify-content: flex-end;
  width: 100%;
  box-sizing: border-box;
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  box-sizing: border-box;
  transition: all 0.2s ease;
  opacity: 1;
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.action-btn::after {
  border: none;
}

.action-btn.reject {
  background: #fff2f0;
  color: #ff4d4f;
}

.action-btn.edit {
  background: #f5f7fa;
  color: #666666;
}

.action-btn.publish {
  background: linear-gradient(135deg, #4a90e2 0%, #67b26f 100%);
  color: white;
}

.action-btn.view {
  background: #f5f7fa;
  color: #666666;
}

.publish-time {
  font-size: 24rpx;
  color: #22c55e;
  font-weight: 500;
  margin-right: 12rpx;
}

/* 空状态居中显示 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 400rpx;
  padding: 40rpx;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.create-btn {
  width: 220rpx;
  height: 68rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #67b26f 100%);
  color: white;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

.create-btn::after {
  border: none;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 28rpx;
  font-size: 24rpx;
  color: #999999;
}
