page {
  min-height: 100vh;
  width: 100vw;
  margin: 0;
  padding: 0;
  background: #f5f7fa;
  overflow-x: hidden;
  display: block;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: 100vw;
  background: #f5f7fa;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.form-container {
  flex: 1;
  min-height: 0;
  height: 100%;
  padding: 24rpx 32rpx 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  min-height: calc(100vh - 140rpx);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.picker-display {
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #e8eaed;
}

.picker-icon {
  width: 32rpx;
  height: 32rpx;
}

.difficulty-options, .target-options {
  display: flex;
  gap: 20rpx;
}

.difficulty-option, .target-option {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8eaed;
  font-size: 26rpx;
  color: #666;
}

.difficulty-option.selected, .target-option.selected {
  background: #4a90e2;
  border-color: #4a90e2;
  color: white;
}

.form-input {
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #e8eaed;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #e8eaed;
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #4a90e2;
  color: white;
  font-size: 28rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-top: 20rpx;
}

.save-btn::after {
  border: none;
}