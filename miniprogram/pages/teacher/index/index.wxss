page {
  height: 100vh;
  width: 100vw;
  margin: 0;
  padding: 0;
  background: #f5f7fa;
  overflow: hidden;
  display: block;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  background: #f5f7fa;
  overflow: hidden;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.content {
  flex: 1 1 0;
  min-height: 0;
  height: 0;
  width: 100%;
  background: #f5f7fa;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.content > view {
  flex: 1 1 0;
  min-height: 0;
  height: 100%;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  overflow-y: auto;
  background: #f5f7fa;
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
  box-sizing: border-box;
}

.tab-bar {
  flex: 0 0 auto;
  height: 100rpx;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e8eaed;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.02);
  box-sizing: content-box;
  width: 100%;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-icon-text {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #999999;
}

.tab-item.active .tab-text {
  color: #4a90e2;
  font-weight: 500;
}

.badge {
  position: absolute;
  top: 16rpx;
  right: 70rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}