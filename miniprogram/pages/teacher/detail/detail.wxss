.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.report-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.report-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.report-time {
  font-size: 24rpx;
  color: #999;
}

.section {
  background-color: white;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 对话内容样式 */
.conversation-content {
  display: flex;
  flex-direction: column;
}

.message-item {
  display: flex;
  margin-bottom: 20rpx;
  max-width: 80%;
}

.user-message {
  flex-direction: row-reverse;
  align-self: flex-end;
}

.ai-message {
  align-self: flex-start;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin: 0 15rpx;
}

.user-message .message-avatar {
  background-color: #4a90e2;
  color: white;
}

.ai-message .message-avatar {
  background-color: #50e3c2;
  color: white;
}

.message-content {
  flex: 1;
  padding: 15rpx;
  border-radius: 15rpx;
  position: relative;
}

.user-message .message-content {
  background-color: #4a90e2;
  color: white;
  border-bottom-right-radius: 5rpx;
}

.ai-message .message-content {
  background-color: #f0f0f0;
  color: #333;
  border-bottom-left-radius: 5rpx;
}

.message-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
  word-break: break-word;
}

.message-time {
  display: block;
  font-size: 20rpx;
  opacity: 0.7;
  text-align: right;
}

/* 分析结果样式 */
.analysis-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.analysis-item {
  display: flex;
  flex-direction: column;
}

.analysis-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.analysis-value {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 错误点分析样式 */
.error-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.error-item {
  background-color: #fff7e6;
  border-radius: 15rpx;
  padding: 20rpx;
  border-left: 5rpx solid #fa8c16;
}

.error-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 5rpx;
  display: block;
}

.error-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
  display: block;
}

.suggestion-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #52c41a;
  margin-bottom: 5rpx;
  display: block;
}

.suggestion-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}

/* 教师评分和反馈样式 */
.teacher-feedback {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-container {
  display: flex;
  align-items: center;
}

.score-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.score-input input {
  width: 200rpx;
  height: 60rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 0 15rpx;
  font-size: 26rpx;
}

.feedback-container {
  display: flex;
  flex-direction: column;
}

.feedback-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.feedback-container textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 操作按钮 */
.action-container {
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #e8e8e8;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  background-color: #4a90e2;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
