page {
  background: #ffffff;
  min-height: 100vh;
  margin: 0;
  padding: 0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
  margin: 0;
  padding: 0;
}

.report-container {
  flex: 1;
  padding: 20rpx 20rpx 24rpx 20rpx;
  overflow-y: auto;
  margin: 0;
}

.report-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.report-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.report-time {
  font-size: 24rpx;
  color: #999;
}

.section {
  background-color: white;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #333333;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 对话内容样式 */
.conversation-content {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}

.message-wrapper {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.3s ease;
  display: flex;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ai-wrapper {
  justify-content: flex-start;
  padding-left: 16rpx;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin: 0 15rpx;
  background-color: #4a90e2;
  color: white;
  flex-shrink: 0;
}

.ai-wrapper .message-avatar {
  background-color: #4a90e2;
  color: white;
}

.message-bubble {
  padding: 24rpx;
  border-radius: 24rpx;
  position: relative;
  max-width: 85%;
}

.user-bubble {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.35);
  position: relative;
}

.user-bubble::before {
  content: '';
  position: absolute;
  left: -15rpx;
  top: 20rpx;
  border-width: 15rpx 15rpx 15rpx 0;
  border-style: solid;
  border-color: transparent #2563eb transparent transparent;
}

.ai-bubble {
  background: #fefefe;
  color: #0a0a0a;
  border-radius: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #333333;
  position: relative;
}

.ai-bubble::before {
  content: '';
  position: absolute;
  left: -15rpx;
  top: 20rpx;
  border-width: 15rpx 15rpx 15rpx 0;
  border-style: solid;
  border-color: transparent #333333 transparent transparent;
}

.message-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-word;
  margin-bottom: 16rpx;
}

.message-time {
  display: block;
  font-size: 22rpx;
  opacity: 0.6;
  text-align: right;
}

/* 分析结果样式 */
.analysis-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.analysis-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.analysis-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.analysis-value {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 错误点分析样式 */
.error-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.error-item {
  background-color: #fff7e6;
  border-radius: 15rpx;
  padding: 20rpx;
  border-left: 5rpx solid #fa8c16;
}

.error-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 5rpx;
  display: block;
}

.error-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
  display: block;
}

.suggestion-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #52c41a;
  margin-bottom: 5rpx;
  display: block;
}

.suggestion-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}

/* 教师评分和反馈样式 */
.teacher-feedback {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-container {
  display: flex;
  align-items: center;
}

.score-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.score-input input {
  width: 250rpx;
  height: 60rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 0 15rpx;
  font-size: 26rpx;
}

.feedback-container {
  display: flex;
  flex-direction: column;
}

.feedback-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.feedback-container textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 操作按钮 */
.action-container {
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #e8e8e8;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  background-color: #4a90e2;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
