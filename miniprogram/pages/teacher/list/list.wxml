<view class="container">
  <!-- 待批阅列表 -->
  <scroll-view class="list-container" scroll-y="true">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{reports.length === 0}}">
      <text>暂无待批阅的报告</text>
    </view>
    
    <!-- 报告列表项 -->
    <view wx:for="{{reports}}" wx:key="{{item.conversationId}}" class="report-item" bindtap="viewReport" data-report-id="{{item.conversationId}}">
      <view class="report-header">
        <text class="report-title">学生报告 {{item.originalIndex}}</text>
        <text class="report-status {{item.status && item.status !== '待批阅' ? 'status-reviewed' : 'status-pending'}}">{{item.status || '待批阅'}}</text>
      </view>
      <view class="report-content">
        <text class="report-preview">{{item.messages.length > 0 ? item.messages[0].content : '无内容'}}</text>
      </view>
      <view class="report-footer">
        <text class="report-time">{{item.createdAt}}</text>
        <text class="message-count">{{item.messages.length}} 条消息</text>
      </view>
    </view>
  </scroll-view>
</view>