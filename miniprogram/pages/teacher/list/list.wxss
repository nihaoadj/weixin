page {
  background: #ffffff;
  min-height: 100vh;
  margin: 0;
  padding: 0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
  margin: 0;
  padding: 0;
}

.list-container {
  flex: 1;
  padding: 20rpx 32rpx 28rpx 32rpx;
  overflow-y: auto;
  margin: 0;
  
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80vh;
  font-size: 32rpx;
  color: #999;
}

.report-item {
  background-color: white;
  border-radius: 20rpx;
  padding: 25rpx;
  margin: 10rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #3333332e;
  transition: all 0.3s ease;
}

.report-item:active {
  transform: scale(0.98);
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.report-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.report-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.status-reviewed {
  background-color: #e6f7ff;
  color: #1890ff;
}

.report-content {
  margin-bottom: 15rpx;
}

.report-preview {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.report-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.report-time {
  font-size: 24rpx;
  color: #999;
}

.message-count {
  font-size: 24rpx;
  color: #999;
}
/* 在原有样式基础上，添加这些覆盖样式 */

/* 组件容器 - 居中显示 */
.list-container {
  height: 100% !important;
  width: 100% !important;
  max-width: 750rpx; /* 与父容器保持一致 */
  margin: 0 auto !important; /* 水平居中 */
  padding: 20rpx 24rpx;
  overflow-y: auto !important;
  box-sizing: border-box;
  background: #f5f7fa;
}

/* 滚动视图 - 强制占满 */
.list-container scroll-view,
.list-container > scroll-view {
  height: 100% !important;
  width: 100% !important;
}

/* 空状态居中 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 400rpx;
  font-size: 28rpx;
  color: #999;
}

/* 调整卡片间距和宽度 */
.report-item {
  margin: 0 0 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.report-item:last-child {
  margin-bottom: 0;
}