{
  "name": "medical-qa-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "基于 uni-app、Vue 3、TypeScript、FastAPI 和 SQLite 的医学知识问答小程序",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/adj506/wechat-mini-program.git"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "typescript",
    "weixin-miniprogram",
    "medical-education"
  ],
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build:mp-weixin && npm run build:h5",
    "check:all": "npm run check && npm run backend:check && npm run test:e2e",
    "backend:migrate": "cd backend && python -m alembic upgrade head",
    "backend:dev": "npm run backend:migrate && cd backend && python -m uvicorn app.main:app --reload",
    "backend:test": "cd backend && python -m pytest",
    "backend:check": "cd backend && python -m ruff check . && python -m pytest --cov=app --cov-report=term-missing -q",
    "backend:install": "cd backend && pip install -r requirements-dev.txt",
    "audit:prod": "audit-ci --config audit-ci.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/runtime-core": "3.4.21",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.1.3",
    "audit-ci": "7.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "happy-dom": "20.11.6",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "typescript": "4.9.5",
    "typescript-eslint": "8.66.0",
    "vite": "5.2.8",
    "vitest": "2.1.9",
    "vue-tsc": "1.8.27"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "npm@11.9.0"
}
