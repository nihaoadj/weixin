{
  "name": "medical-qa-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "基于 uni-app、Vue 3、TypeScript、FastAPI 和 SQLite 的医学知识问答小程序",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/adj506/wechat-mini-program.git"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "typescript",
    "weixin-miniprogram",
    "medical-education"
  ],
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mp:doctor": "node scripts/wechat/doctor.mjs",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run structure:check && npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build:mp-weixin",
    "check:all": "npm run check && npm run contract:check && npm run backend:check && npm run backend:audit && npm run audit:prod && npm run audit:all",
    "backend:migrate": "cd backend && python -m alembic upgrade head",
    "backend:dev": "npm run backend:migrate && cd backend && python -m uvicorn app.main:app --reload",
    "backend:test": "cd backend && python -m pytest",
    "backend:check": "cd backend && python -m ruff check . && python -m pytest --cov=app --cov-report=term-missing -q",
    "backend:install": "cd backend && python -m pip install --require-hashes -r requirements-dev.txt",
    "backend:audit": "cd backend && python -m pip_audit -r requirements.txt",
    "contract:export": "cd backend && python scripts/export_openapi.py ../docs/openapi.json",
    "contract:types": "openapi-typescript docs/openapi.json --empty-objects-unknown --output src/data/contracts/openapi.generated.ts",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:check": "node scripts/contract.mjs check",
    "audit:prod": "audit-ci --config audit-ci.prod.json",
    "audit:all": "audit-ci --config audit-ci.all.json",
    "backend:test:safety": "cd backend && python -m pytest tests/test_database_safety.py -q",
    "backend:test:migrations": "cd backend && python -m pytest tests/test_migrations.py -q",
    "security:secrets": "node scripts/security-secrets.mjs --scope=all",
    "security:secrets:self-test": "node scripts/security-secrets.mjs --self-test",
    "structure:check": "python scripts/check-code-organization.py && node scripts/frontend-boundaries.mjs && python backend/scripts/check_boundaries.py",
    "structure:self-test": "python scripts/check-code-organization.py --self-test && node scripts/frontend-boundaries.mjs --self-test && python backend/scripts/check_boundaries.py --self-test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020520260824002",
    "@dcloudio/uni-components": "3.0.0-alpha-5020520260824002",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020520260824002",
    "vue": "3.4.21",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020520260824002",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260824002",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.6",
    "@vue/runtime-core": "3.4.21",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.7.0",
    "audit-ci": "7.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "happy-dom": "20.11.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "3.2.6",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "2.2.12"
  },
  "overrides": {
    "@intlify/core-base": "9.14.5",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/message-resolver": "9.1.11",
    "@intlify/runtime": "9.1.10",
    "@intlify/vue-devtools": "9.1.10",
    "adm-zip": "0.6.0",
    "express": "4.22.1",
    "jpeg-js": "0.4.4",
    "nanoid": "3.3.18",
    "minimist": "1.2.8",
    "phin": "3.7.1",
    "path-to-regexp": "0.1.13",
    "postcss": "8.5.26",
    "ws": "8.21.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "npm@11.9.0"
}
